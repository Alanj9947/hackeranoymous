# ============================================================
# AI Voice Agent Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# ---------- General ----------
APP_NAME=VoiceAgentPlatform
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
LOG_LEVEL=info

# ---------- Database (PostgreSQL) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=voiceagent
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=changeme_pg_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0
CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ---------- Auth / JWT ----------
JWT_SECRET_KEY=change-me-jwt-secret-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_BASE_URL=https://your-domain.com

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4
OPENAI_WHISPER_MODEL=whisper-1

# ---------- ElevenLabs (TTS) ----------
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=default_voice_id

# ---------- Azure TTS (alternative) ----------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---------- Custom AI Server (VPS) ----------
CUSTOM_AI_SERVER_ENDPOINT=https://your-vps-ip:5000
CUSTOM_AI_SERVER_API_KEY=your-secure-api-key
CUSTOM_AI_SERVER_TIMEOUT=120
CUSTOM_AI_SERVER_MAX_RETRIES=2
CUSTOM_AI_SERVER_HEALTH_INTERVAL=30

# ---------- Google Sheets ----------
GOOGLE_SERVICE_ACCOUNT_FILE=config/google-service-account.json
GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/drive

# ---------- File Storage (S3/MinIO) ----------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RECORDINGS=recordings
S3_BUCKET_EXPORTS=exports
S3_REGION=us-east-1
S3_USE_SSL=false

# ---------- Sentry (Error Tracking) ----------
SENTRY_DSN=

# ---------- CORS ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Frontend ----------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
